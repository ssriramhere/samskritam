{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node scripts/build_reviewed.mjs",
  "outputDirectory": "web",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/read.py": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "engine/**",
      "excludeFiles": "{web/**,reviewed/**,scripts/**,api/*.js,README.md,LICENSE*,NOTICE}"
    }
  },
  "git": {
    "deploymentEnabled": {
      "suggest-*": false,
      "review-*": false
    }
  }
}
